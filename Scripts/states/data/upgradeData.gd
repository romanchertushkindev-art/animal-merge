class_name UpgradeData
extends Resource

# Описание одного апгрейда для вкладки «Апгрейды».
# Устроено так же, как SlimeData: ресурс лежит в папке
# Resources/upgrades/upgradesData/, UpgradeFactory подхватывает всю папку,
# а карточка магазина рисуется по тем же полям.
#
# В отличие от слизня апгрейд не кладётся в инвентарь и не занимает
# слот: покупка сразу ставит его на ферму.

# ============================================
# ОСНОВНАЯ ИНФОРМАЦИЯ
# ============================================
@export var id: String = ""
@export var display_name: String = ""
@export var description: String = ""
@export var shop_texture: Texture2D

# Что именно появляется на ферме после покупки
@export var scene: PackedScene

# ============================================
# ЦЕНА (для магазина)
# ============================================
# Как и у слизней — экспоненциально: каждая следующая копия дороже,
# иначе на жабы уходит весь доход, а слизни прокачивать не на что.
@export_group("Цена")
@export var unlock_price: float = 0.0      # цена первого открытия (0 = стартовый)
@export var price: float = 250.0           # база для следующих копий
@export var price_growth: float = 1.7      # множитель за каждую купленную копию
@export var max_count: int = 0             # 0 = без ограничения

# Какую долю капель ферма апгрейд собирает вместо игрока. Нужно для
# оценки дохода: по этой доле считается, сколько ферма заработает,
# а от этого гонка считает свою награду. Замерено: одна жаба съедает
# примерно четверть капель и платит за них FROG_PAYOUT.
@export var income_coverage: float = 0.0

# ============================================
# ПАРАМЕТРЫ ПРИ СПАВНЕ
# ============================================
# Баланс живёт здесь, а не на узле сцены. Раньше настройки жабы
# были выставлены прямо на экземпляре в main.tscn, поэтому любая
# жаба, купленная в магазине, выходила с дефолтами скрипта и не
# дотягивалась до капель. Ноль означает «не трогать».
@export_group("Параметры при спавне")
@export var attack_radius: float = 0.0
@export var attack_interval: float = 0.0
@export var tongue_speed: float = 0.0
@export var swallow_duration: float = 0.0

# ============================================
# СТАРТ
# ============================================
# Сколько таких апгрейдов у игрока сразу, без покупок.
# Стартовая жаба раньше была просто зашита в main.tscn —
# теперь её ставит ферма, считая это стартовым количеством.
@export var starter_count: int = 0

# ============================================
# УТИЛИТЫ
# ============================================
func is_starter() -> bool:
	return starter_count > 0

## Цена следующей копии апгрейда. owned — сколько таких уже куплено.
## Как у слизней: цена не должна падать на второй копии.
func get_copy_price(owned: int) -> float:
	if owned <= 0:
		return unlock_price
	return maxf(price * pow(price_growth, owned - 1), get_copy_price(owned - 1))

func get_effective_price(is_unlocked: bool) -> float:
	return price if is_unlocked else unlock_price
