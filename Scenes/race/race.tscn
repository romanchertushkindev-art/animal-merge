[sub_resource type="GDScript" id="GDScript_ed64k"]
script/source = "extends Camera2D

# Ссылка на игрока. Замените CharacterBody2D на класс вашего игрока, если нужно.
@export var player: CharacterBody2D 

# Задаем фиксированную высоту, на которой камера должна стоять
@export var fixed_y_position: float = 300.0 

# Скорость плавного догона камеры
@export var smoothing_speed: float = 5.0

@export var min_x: int = 0      # Левый предел в пикселях
@export var max_x: int = 2000   # Правый предел в пикселях

func _ready() -> void:
	# Устанавливаем встроенные лимиты камеры
	limit_left = min_x
	limit_right = max_x
	
	if player:
		global_position.y = fixed_y_position
		global_position.x = player.global_position.x

func _process(delta: float) -> void:
	if player:
		# Целевая позиция: X берем от игрока, а Y оставляем фиксированным
		var target_position = Vector2(player.global_position.x, fixed_y_position)
		
		# Плавно двигаем камеру только к новой координате X
		global_position = global_position.lerp(target_position, smoothing_speed * delta)
"

